# Copy this file to .env and fill in real values. Never commit .env.
DB_PASSWORD=change-me-to-a-strong-password
# 32+ random characters, e.g. generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Port the site is published on (80 for a server, or e.g. 8081 to test locally)
HTTP_PORT=80
